{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "marketplace-api",
    "Audience": "marketplace-api",
    "ExpiresInMinutes": 60
  },
  "Orders": {
    "PaymentTimeout": "00:15:00",
    "ExpirationCheckInterval": "00:00:30"
  }
}